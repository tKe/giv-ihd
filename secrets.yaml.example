# Copy this file to secrets.yaml (gitignored) and fill in real values.

# Native API noise-encryption PSK. Generate one with:
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
api_key: "CHANGE_ME"

# Home Assistant long-lived access token: your HA profile page (click your
# username, bottom left) -> scroll to "Long-Lived Access Tokens" -> Create
# Token. Used by http_request/ha_history to call back into HA.
ha_key: "CHANGE_ME"

# Password for the device's fallback AP (wifi: ap: in givenergy_dashboard.yaml),
# used only if it can't join your real network.
fallback_pass: "CHANGE_ME"

# Your WiFi network.
wifi_ssid: "CHANGE_ME"
wifi_password: "CHANGE_ME"
